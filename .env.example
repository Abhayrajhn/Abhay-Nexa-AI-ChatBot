# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys

# Copy this file to application.properties and add your real API key
OPENAI_API_KEY=sk-your-api-key-here

# Available models:
# - gpt-4o-mini (recommended for learning - fast and cheap)
# - gpt-4o (more capable but more expensive)
# - gpt-3.5-turbo (older, cheaper)
